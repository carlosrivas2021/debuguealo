Screen { background: #080b0e; color: #d6d9dc; }
#area-navigation { height: 1; background: #101518; }
#area-navigation Button { width: auto; min-width: 12; }
#area-navigation Button.-primary { background: #30414c; color: #ffffff; text-style: bold; }
#container-area, #code-workspace { height: 1fr; }
#code-title, #code-status, #code-capabilities { height: auto; padding: 0 1; }
#code-title { color: #a9c2cc; }
#code-reload { width: auto; }
#code-actions { height: 1; }
#code-actions Button { width: auto; }
#code-projects { height: 3; min-height: 3; }
#source-browser { height: 3fr; min-height: 7; }
#source-status { height: 1; color: #9db5bf; padding: 0 1; }
#source-content { height: 1fr; }
#source-tree { width: 22%; background: #101518; color: #c8cdd1; }
#source-text { width: 1fr; border: none; background: #080b0e; color: #d6d9dc; }
#source-breakpoint { width: auto; }
#code-run-state { height: 1; padding: 0 1; color: #a9c2cc; }
#code-terminal { height: 2fr; min-height: 4; border-top: solid #2b3439; }
#code-debug { height: 2fr; min-height: 9; border-top: solid #2b3439; }
#code-debug-controls { height: 1; }
#code-debug-controls Button { width: auto; min-width: 10; }
#code-inspection { height: 1fr; min-height: 3; }
#code-stack { width: 45%; }
#code-variables { width: 1fr; height: 1fr; overflow: auto; padding: 0 1; }
#code-debug-output { height: 1fr; min-height: 3; background: #080b0e; }
Button { height: 1; min-height: 1; border: none; padding: 0 1; background: #171c20; color: #c8cdd1; }
Button:hover { background: #242c32; }
Button:focus { background: #30414c; color: #ffffff; text-style: bold; }
Button:disabled { color: #697279; background: #101417; }
#topbar { height: 2; background: #101518; padding: 0 1; border-bottom: solid #2b3439; }
#open-launch-file { width: 20; min-width: 20; height: 1; border: none; padding: 0; }
#docker-state { width: 1fr; height: 1; background: #101518; color: #9db5bf; padding: 0 1; }
#dashboard { height: 1fr; min-height: 8; }
#sidebar { width: 48; border: none; scrollbar-gutter: stable; background: #080b0e; }
#launch-section { height: 1fr; min-height: 8; }
#launch-section.empty-launch { height: 9; }
#launch-title { width: 1fr; height: 1; color: #a9c2cc; padding: 0 1; }
#launch-profiles { height: 1fr; }
#profile-actions { display: none; layout: horizontal; height: 1; }
#profile-actions Button { width: 1fr; min-width: 10; height: 1; }
#empty-welcome { display: none; height: 6; padding: 0 1; color: #9ba5aa; }
#empty-welcome-message { height: 3; }
#empty-welcome Button { width: 1fr; min-width: 14; height: 1; }
#active-container-heading { layout: horizontal; height: 1; }
#active-containers-title { width: 1fr; height: 1; color: #a9c2cc; }
#show-all { width: auto; height: 1; padding: 0; border: none; }
#container-info { height: 4; color: #9ba5aa; padding: 0 1; }
#right-panel { width: 1fr; height: 1fr; border: none; border-left: solid #2b3439; }
#logs-panel { width: 1fr; height: 1fr; border: none; }
#container-details { display: none; height: auto; max-height: 10; padding: 0 1; border-bottom: solid #2b3439; }
#container-details-title { height: 1; color: #a9c2cc; }
#container-details-content { height: auto; color: #9ba5aa; }
#log-state { height: 1; color: #a9c2cc; padding: 0 1; }
#compose-console { height: 9; min-height: 6; border-top: solid #2b3439; background: #101518; }
#compose-console.output-hidden { height: 3; min-height: 3; }
#compose-console.terminal-active { height: 12; min-height: 7; }
#compose-console.terminal-active.output-hidden { height: 8; min-height: 7; }
#compose-empty { height: 1; color: #9ba5aa; padding: 0 1; }
#compose-console.output-hidden #compose-empty, #compose-empty.hidden { display: none; }
#compose-output-heading { height: 1; color: #a9c2cc; padding: 0 1; }
#compose-output-toggle { width: 20; height: 1; }
#compose-output-viewer { height: 1fr; padding: 0 1; }
#terminal-context { width: 1fr; height: 1; color: #9ba5aa; padding: 0 1; }
#terminal-close { width: 18; height: 1; }
#terminal-pane { height: 4; min-height: 2; border-top: solid #2b3439; }
#compose-console #terminal-pane { display: none; }
#compose-console.terminal-active #terminal-pane { display: block; }
#debugger-state { display: none; }
#inline-compose { display: none; height: 3; background: #292316; }
#inline-compose-message { width: 1fr; height: 3; padding: 0 1; }
#inline-compose Button { width: 12; min-width: 10; height: 1; }
.compact #dashboard { layout: vertical; }
.compact #sidebar { width: 1fr; height: 14; }
.compact #launch-section { height: 1fr; min-height: 6; }
.compact #launch-section.empty-launch { height: 4; min-height: 4; }
.compact #empty-welcome { height: 3; }
.compact #empty-welcome-message { height: 1; }
.compact #empty-welcome Button { height: 1; border: none; padding: 0; }
.compact #profile-actions { display: none; }
.compact #container-info { display: none; }
.compact #compose-console { height: 8; min-height: 6; }
.compact #compose-console.output-hidden { height: 3; min-height: 3; }
.compact #compose-console.terminal-active { height: 11; min-height: 7; }
.compact #compose-console.terminal-active.output-hidden { height: 7; min-height: 6; }
.compact #terminal-pane { height: 3; min-height: 2; }
.compact #container-details { max-height: 7; }
.compact #debugger-state { display: none; }
.compact #code-status, .compact #code-capabilities { height: 1; max-height: 1; }
.compact #source-browser { height: 7; min-height: 7; max-height: 7; }
.compact #code-debug { height: 7; min-height: 7; max-height: 7; }
.compact #code-inspection { min-height: 2; }
.compact #code-debug-output { min-height: 2; }
#launch-state { height: 1; color: #9ba5aa; padding: 0 1; }

/* Compact native controls and the existing artboard palette, not theme defaults. */
#launch-profiles { background: #080b0e; }
#active-container-heading { background: #101518; }
#log-state { background: #101518; padding: 0 1; }
LogViewer { background: #080b0e; }
LogViewer .log-controls { height: 1; padding: 0 1; background: #101518; }
LogViewer Input { height: 1; min-height: 1; border: none; padding: 0 1; margin: 0 1 0 0; background: #171c20; color: #d6d9dc; }
LogViewer Input:focus { background: #30414c; }
LogViewer Select { height: 1; min-height: 1; width: 16; border: none; padding: 0; }
LogViewer SelectCurrent { height: 1; min-height: 1; border: none; padding: 0; background: #171c20; }
LogViewer .log-status { color: #9ba5aa; padding: 0 1; }
DataTable { background: #080b0e; color: #d6d9dc; }
DataTable > .datatable--header { background: #101518; color: #a9c2cc; text-style: bold; }
DataTable:focus > .datatable--header { background-tint: transparent; }
DataTable > .datatable--odd-row { background: #080b0e; }
DataTable > .datatable--even-row { background: #101518; }
DataTable > .datatable--cursor { background: #30414c; color: #ffffff; }
DataTable > .datatable--header-cursor { background: #101518; color: #a9c2cc; }
DataTable > .datatable--hover { background: #242c32; }
Footer, FooterKey, FooterLabel { background: #101518; color: #9ba5aa; }
FooterKey > .footer-key--key { background: #101518; color: #a9c2cc; }
FooterKey > .footer-key--description { background: #101518; color: #9ba5aa; }

/* Container shells share the right-hand logs region; Host Bash stays in the dock. */
#container-shell { display: none; height: 1fr; background: #080b0e; }
#container-shell-controls { height: 1; background: #101518; }
#container-terminal-context { width: 1fr; height: 1; color: #9ba5aa; }
#container-shell-logs { width: 8; }
#container-terminal-close { width: 16; }
#container-terminal-pane { height: 1fr; min-height: 2; background: #080b0e; }
